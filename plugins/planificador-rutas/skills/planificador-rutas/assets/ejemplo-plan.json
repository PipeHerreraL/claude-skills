 "avisos": [
  {
   "titulo": "Tramo crítico",
   "alerta": true,
   "texto": "La Peña – Villagómez – Pacho depende de vías terciarias de montaña y el día 2 la recorre completa. Si llueve fuerte, duerma en Pacho igual y haga Villagómez como ida y vuelta desde Pacho la mañana del día 3."
  },
  {
   "titulo": "Dónde se recortó",
   "texto": "Albán baja a 65 minutos y Guayabal a 70 porque comparten la tarde del día 4; Vergara y Sasaima quedan en 75 por la hora y media que las separa. Nueve municipios conservan los 90 completos."
  },
  {
   "titulo": "Las horas fuera de ventana",
   "texto": "Las salidas de 6:45 del día 2 y de 6:30 del día 4 no son opcionales: sin ellas la primera visita no abre a las 8:00 y se cae un municipio."
  },
  {
   "titulo": "Combustible",
   "texto": "Tanquee en Honda, Villeta, Pacho y Mariquita. Entre La Peña y Villagómez no hay estaciones confiables."
  },
  {
   "titulo": "Alojamiento",
   "texto": "Villeta, La Vega y Pacho tienen oferta suficiente. Bituima es el punto débil: si no consigue habitación, duerma en Guayabal de Síquima o en Albán y arranque 30 minutos antes."
  },
  {
   "titulo": "Estado de vías",
   "texto": "Confirme el paso por Alto de Letras y los tramos de Rionegro con INVÍAS (#767) antes de salir."
  }
 ],
